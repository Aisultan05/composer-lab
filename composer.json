{
    "name": "aisultan/composer-lab",
    "type": "project",
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:Aisultan05/slugger.git",
            "no-api": true
        }
    ],
    "require": {
        "aisultan/slugger": "^1.0"
    },
    "config": {
        "preferred-install": {
            "aisultan/*": "source"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
